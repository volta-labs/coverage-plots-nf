// ── coverage-plots-nf nextflow.config ─────────────────────────────────────────────────
// Matches the Volta Labs AWS Batch + Wave + Fusion setup used in illumina-metrics-nf

manifest {
    name        = 'coverage-plots-nf'
    description = 'HCS v2 post-capture QC plots: chromosome coverage, GC bias, coverage heterogeneity'
    version     = '1.0.0'
    nextflowVersion = '>=23.0'
}

// ── Default parameters ────────────────────────────────────────────────────────
params {
    input      = null
    groups_tsv = null
    bed        = 's3://volta-labs-sequencing-data/reference-genome-index/hybrid-capture-target-files/hcs_v2_inferred_final_v1.bed'
    gc_cache   = 's3://volta-labs-sequencing-data/reference-genome-index/hybrid-capture-target-files/hcs_v2_inferred_target_gc_v1.csv'
    run_name   = 'HCS_QC'
    outdir     = null
}

// ── AWS + Executor ────────────────────────────────────────────────────────────
process {
    executor = 'awsbatch'

    // Resources per process type
    withName: 'BEDTOOLS_COVERAGE' {
        memory = '8 GB'
        cpus   = 2
        time   = '2 h'
    }
    withName: 'PLOT_QC' {
        memory = '4 GB'
        cpus   = 1
        time   = '30 min'
    }
    withName: 'PLOT_HETEROGENEITY' {
        memory = '4 GB'
        cpus   = 1
        time   = '30 min'
    }
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/usr/local/bin/aws'
    }
    client {
        uploadChunkSize = '10 MB'
        maxErrorRetry   = 10
    }
}

// ── Wave (auto-builds containers from conda specs) ────────────────────────────
wave {
    enabled  = true
    strategy = ['conda', 'container']
}

// ── Fusion FS (transparent S3 access) ─────────────────────────────────────────
fusion {
    enabled = true
}

// ── Work directory (S3 scratch, same bucket as other pipelines) ───────────────
workDir = 's3://vl-nextflow/scratch/'

// ── Seqera Platform monitoring ────────────────────────────────────────────────
tower {
    enabled    = true
    endpoint   = 'https://api.cloud.seqera.io'
    workspaceId = 'Volta_Labs/app_dev'
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    // Run locally for testing (no AWS needed)
    local {
        process.executor = 'local'
        wave.enabled     = false
        fusion.enabled   = false
        workDir          = 'work'
    }
}
